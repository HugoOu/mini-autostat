# Mini AutoSTAT 环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，切勿提交密钥。

# ---- LLM 配置（D-002：OpenCode Go 提供的 GLM-5.3-Flash，OpenAI-compatible 接口）----
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=glm-5.3-flash

# ---- 运行预算（可被命令行参数覆盖，命令行优先）----
MAX_TURNS=12
MAX_REPAIR_ROUNDS=3

# ---- 数据路径（可选，默认 owid-energy-data.csv）----
# DATA_PATH=owid-energy-data.csv
