# Mini AutoSTAT 环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，切勿提交密钥。

# ---- LLM 配置（D-002：OpenAI-compatible 接口）----
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=glm-5.3-flash

# ---- Leader / Worker 分模型（D-026，可选）----
# 未设置时 Leader 与 Worker 均回退 OPENAI_MODEL。
# OPENAI_LEADER_MODEL=glm-5.3-flash
# OPENAI_WORKER_MODEL=deepseek-v4-flash

# ---- 请求附加字段（可选，JSON 格式，随请求体透传给提供方）----
# 常见用途：思考链开关（GLM 系列为 thinking.type；不同提供方字段可能不同）。
# OPENAI_LEADER_EXTRA_BODY={"thinking": {"type": "enabled"}}
# OPENAI_WORKER_EXTRA_BODY={"thinking": {"type": "disabled"}}

# ---- 报告生成专属模型（D-039，可选）----
# 未设置时回退 Leader 模型。GLM-5.3-Flash 对报告级长调用间歇性 HTTP 500，
# 推荐换 Qwen3.8-Flash（思考链开启 + 推理力度 xhigh）。
# OPENAI_REPORT_MODEL=qwen3.8-flash
# OPENAI_REPORT_EXTRA_BODY={"enable_thinking": true, "reasoning_effort": "xhigh"}

# ---- 运行预算（可被命令行参数覆盖，命令行优先）----
MAX_TURNS=12
MAX_REPAIR_ROUNDS=3

# ---- 数据路径（可选，默认 owid-energy-data.csv）----
# DATA_PATH=owid-energy-data.csv
